# config.env
# --- Konfiguracja środowiska dla skryptów cronowych ---

# Ścieżki
WORKING_DIR="/path/to/elektronik-webpage"
BACKUP_DIR="/path/to/backups/elektronik-webpage"
LOG_DIR="${BACKUP_DIR}/logs"

# Adres API Strapi (używany do sprawdzania, czy działa)
STRAPI_URL="https://example.com/admin"

# Nazwy usług w docker-compose
STRAPI_SERVICE="strapi"
FRONTEND_SERVICE="frontend"

# Ilość dni, po których kasujemy stare backupy
BACKUP_RETENTION_DAYS=30
